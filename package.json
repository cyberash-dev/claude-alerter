{
  "name": "claude-sound-notify",
  "version": "1.0.0",
  "description": "Cross-platform sound notifier for Claude Code hooks: loops a sound until the terminal is focused.",
  "license": "MIT",
  "author": "cyberash <cyberash-dev@yandex.com>",
  "homepage": "https://github.com/cyberash-dev/claude-sound-notify#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyberash-dev/claude-sound-notify.git"
  },
  "bugs": {
    "url": "https://github.com/cyberash-dev/claude-sound-notify/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "hooks",
    "notification",
    "sound",
    "notifier",
    "cli",
    "cross-platform"
  ],
  "type": "commonjs",
  "bin": {
    "claude-sound-notify": "dist/src/cli.js"
  },
  "files": [
    "dist/",
    "sounds/",
    "config.example.json"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "gen-sounds": "tsc && node dist/tools/gen-sounds.js",
    "setup": "tsc && node dist/src/cli.js install",
    "prepare": "tsc"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
